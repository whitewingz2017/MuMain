<rml><head><title>Combat statistics</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="docked_panel_frame.rcss"/><link type="text/rcss" href="combat_statistics.rcss"/></head><body><div id="panel" data-model="combat_statistics"><div class="frame-piece frame-top"></div><div class="frame-piece frame-left"></div><div class="frame-piece frame-right"></div><div class="frame-piece frame-bottom"></div><div class="statistics-title">Combat statistics</div><div class="statistics-list"><div class="statistics-row" data-for="line : statistics">{{line}}</div></div><button class="statistics-close" data-event-click="window_close">Close</button><div id="frame_corner_close" data-event-click="window_close"></div></div></body></rml>