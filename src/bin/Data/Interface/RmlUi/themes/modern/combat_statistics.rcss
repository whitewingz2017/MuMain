/* Same docked frame and scale as Attributes; the rows scroll inside it. */
#panel { width: 250px; }
.statistics-title { position: absolute; left: 18px; right: 25px; top: 15px; height: 24px; text-align: center; font-size: 14px; color: #e6c56b; }
.statistics-list { display: block; position: absolute; left: 18px; width: 214px; top: 54px; bottom: 48px; overflow-y: auto; }
.statistics-row { display: block; width: 210px; box-sizing: border-box; padding: 6px 2px; border-bottom: 1px #46505a; color: #eeeeee; font-size: 11px; }
.statistics-close { position: absolute; left: 70px; right: 70px; bottom: 12px; height: 25px; line-height: 25px; text-align: center; font-size: 12px; color: #eeeeee; background-color: #26394a; border: 1px #607c90; }
