<rml><head><title>Chat</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="chat_input.rcss"/></head>
<body class="native-text" data-model="chat_input"><div id="panel">
<input id="whisper_field" type="text" class="text-field cib-whisper-field" placeholder="Whisper" data-value="whisper_id" data-event-change="chat_submit"/>
<input id="chat_field" type="text" class="text-field cib-chat-field" placeholder="Type..." data-value="chat_text" data-event-change="chat_submit"/>
<div id="chat_tabs"><button class="chat-tab" data-class-on="history_tab == 0" data-event-click="chat_history_tab(0)">All</button><button class="chat-tab" data-class-on="history_tab == 1" data-event-click="chat_history_tab(1)">Chat</button><button class="chat-tab" data-class-on="history_tab == 2" data-event-click="chat_history_tab(2)">Whisper</button><button class="chat-tab" data-class-on="history_tab == 3" data-event-click="chat_history_tab(3)">Party</button><button class="chat-tab" data-class-on="history_tab == 4" data-event-click="chat_history_tab(4)">Guild</button><button class="chat-tab" data-class-on="history_tab == 5" data-event-click="chat_history_tab(5)">Alliance</button><button class="chat-tab" data-class-on="history_tab == 6" data-event-click="chat_history_tab(6)">Gens</button><button class="chat-tab" data-class-on="history_tab == 7" data-event-click="chat_history_tab(7)">System</button></div></div><div id="classic_chat_controls">		<!-- Input target: normal / party / guild / gens. Exactly one is lit at a time. -->
		<div id="btn_type_0" class="cib-btn cib-btn-normal" data-class-on="input_msg_type == 0"
		     data-event-click="chat_set_type(0)" data-attr-data-hint="hint_0"></div>
		<div id="btn_type_1" class="cib-btn cib-btn-party" data-class-on="input_msg_type == 1"
		     data-event-click="chat_set_type(1)" data-attr-data-hint="hint_1"></div>
		<div id="btn_type_2" class="cib-btn cib-btn-guild" data-class-on="input_msg_type == 2"
		     data-event-click="chat_set_type(2)" data-attr-data-hint="hint_2"></div>
		<div id="btn_type_3" class="cib-btn cib-btn-gens" data-class-on="input_msg_type == 3"
		     data-event-click="chat_set_type(3)" data-attr-data-hint="hint_3"></div>

		<!-- Independent toggles. -->
		<div id="btn_whisper" class="cib-btn cib-btn-whisper" data-class-on="block_whisper"
		     data-event-click="chat_toggle_whisper_block" data-attr-data-hint="hint_4"></div>
		<div id="btn_system" class="cib-btn cib-btn-system" data-class-on="show_system"
		     data-event-click="chat_toggle_system" data-attr-data-hint="hint_5"></div>
		<div id="btn_chatlog" class="cib-btn cib-btn-chatlog" data-class-on="show_chat_log"
		     data-event-click="chat_toggle_chatlog" data-attr-data-hint="hint_6"></div>
		<div id="btn_frame" class="cib-btn cib-btn-frame" data-class-on="show_frame"
		     data-event-click="chat_toggle_frame" data-attr-data-hint="hint_7"></div>

		<!-- These two only exist while the chat log frame is shown, matching native, which renders
		     them from inside its own IsShowFrame() branch. -->
		<div id="btn_size" class="cib-btn cib-btn-size on" data-class-hidden="!show_frame"
		     data-event-click="chat_size_step" data-attr-data-hint="hint_8"></div>
		<div id="btn_transparency" class="cib-btn cib-btn-alpha on" data-class-hidden="!show_frame"
		     data-event-click="chat_alpha_step" data-attr-data-hint="hint_9"></div>

</div></body></rml>
