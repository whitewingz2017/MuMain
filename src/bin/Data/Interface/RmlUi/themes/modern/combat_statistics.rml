<rml><head><title>Combat statistics</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="docked_panel_frame.rcss"/><link type="text/rcss" href="combat_statistics.rcss"/></head><body><div id="panel" data-model="combat_statistics"><div class="modern-shell-edge"></div><div class="modern-groove"></div><div class="modern-header-rail-px docked-header-rail-fill"><div class="modern-joint-px"></div><div class="docked-rail-accent"></div></div><div class="statistics-title">Combat statistics</div><div class="statistics-list"><div class="statistics-row" data-for="line : statistics">{{line}}</div></div><button class="statistics-close" data-event-click="window_close">Close</button><div id="frame_corner_close" data-event-click="window_close"></div></div></body></rml>