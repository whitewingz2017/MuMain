/* Modern theme's top-right system-button panel (main_frame_top.rml). */

/* #top_right_row / #buttons_top: the top-right system-button panel. #top_right_row is a
   full-width flex row anchored at screen (0,0); `justify-content:flex-end` pushes #buttons_top to
   the right edge. #buttons_top visually echoes mu_helper_bar.rcss's panel/button styling
   (values copied, not shared -- the documents stay independent). */
#top_right_row {
	width: 100%;
	display: flex;
	justify-content: flex-end;
}
#buttons_top.workspace-placed { position: absolute; transform-origin: left top; }
#buttons_top {
	position: relative;
	width: 306dp;
	height: 24dp;
	font-family: "token(font-body)";
	background-color: rgba(15, 16, 13, 190);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}
.frame-btn-top {
	position: absolute;
	top: 4dp;
	width: 48dp;
	height: 16dp;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	line-height: 16dp;
	font-family: "token(font-body)";
	background-color: token(surface-control);
	border: 1dp token(border-frame);
	border-radius: 2dp;
	color: #ffffff;
	font-weight: bold;
	font-effect: outline(1dp #000000);
	font-size: 8dp;
}
.frame-btn-top:hover {
	background-color: token(accent-steel);
	border: 1dp token(accent-steel);
}







.alert-dot-top {
	position: absolute;
	top: -2dp;
	right: -2dp;
	width: 6dp;
	height: 6dp;
	border-radius: token(radius-sm)dp;
	background-color: token(semantic-warning);
	border: 1dp rgba(0, 0, 0, 150);
	pointer-events: none;
}



#buttons_top.workspace-placed { margin-left: -5vw; margin-top: 1.5vh; }

.mobile-layout-editing #buttons_top { pointer-events: auto; border: 1px #e1c26d; }
.mobile-layout-editing .edit-selected { border-color: #7cffff; }

#buttons_top { background-color: transparent; border-width: 0; }
.frame-btn-top { background-color: #246280; border-color: #5594aa; }

/* Six columns; more actions continue on the next row. The arrow remains outside the grid. */
#buttons_top { width: 300dp; height: auto; min-height: 20dp; padding: 4dp; margin-right: 20dp; display: flex; flex-wrap: wrap; }
.frame-btn-top { position: relative; top: 0; box-sizing: border-box; flex: 0 0 48dp; width: 48dp; margin-right: 2dp; margin-bottom: 4dp; }
/* One line on every platform: iOS lays the bold label out wider and wrapped "BANK" below. */
.frame-btn-top { white-space: nowrap; overflow: hidden; }
#btn_bank_top { font-size: 6dp; }




#top_panel_toggle { position: absolute; right: -20dp; top: 4dp; width: 16dp; height: 16dp; pointer-events: auto; }
#buttons_top.collapsed .frame-btn-top { display: none; }
#buttons_top.collapsed { height: 24dp; border-color: transparent; }


@spritesheet top-menu-open-sheet {
    src: "../../assets/mobile/TournamentBTN_I36.tga";
    top-menu-open: 0px 0px 30px 48px;
}
@spritesheet top-menu-close-sheet {
    src: "../../assets/mobile/TournamentBTN_I38.tga";
    top-menu-close: 0px 0px 30px 48px;
}
#top_panel_toggle { decorator: image(top-menu-close); }
#buttons_top.collapsed #top_panel_toggle { decorator: image(top-menu-open); }

.frame-btn-top span { pointer-events: none; }
