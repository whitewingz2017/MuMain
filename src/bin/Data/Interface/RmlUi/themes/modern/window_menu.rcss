/* Match the Command panel size and dock fit while keeping the menu above the HUD.
   Reference px receive the panel scale once; labels retain their native size. */

#screen {
	left: 0;
	width: 100%;
	height: 100%;
	margin-left: 0;
	transform: none;
	--root-scale: calc(min(var(--dock-scale, 1), (var(--workspace-bottom, 100vh) - var(--workspace-top, 0px)) / 432px));
	pointer-events: none;
}

#panel {
	position: absolute;
	left: auto;
	top: calc(var(--workspace-bottom, 100vh) - 432px * var(--root-scale));
	right: calc(50% - 285px * var(--hud-scale, 1));
	width: 190px;
	height: 432px;
	transform-origin: right top;
	transform: scale(var(--root-scale));
	font-family: "token(font-body)";
	background-color: rgba(22, 26, 32, 140);
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 20), rgba(255, 255, 255, 0) 30%);
	border: 1px rgba(255, 255, 255, 46);
	border-top-color: rgba(255, 255, 255, 80);
	border-radius: 6px;
	pointer-events: auto;
}

#back, #frame_up, .frame-middles, #frame_down, .lines, .arrow {
	display: none;
}

#rows {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 12px;
	bottom: 12px;
	overflow: hidden auto;
	pointer-events: auto;
}

.menu-row {
	display: block;
	position: relative;
	box-sizing: border-box;
	height: 24px;
	margin-bottom: 4px;
	background-color: rgba(255, 255, 255, 22);
	border: 1px rgba(255, 255, 255, 90);
	border-bottom-width: 2px;
	border-radius: 3px;
	pointer-events: auto;
	cursor: pointer;
}

/* Redeem, Excellent Combination, Event Timers and Muun entries now live in the top menu. */
.menu-row[menu-entry="14"], .menu-row[menu-entry="15"],
.menu-row[menu-entry="16"], .menu-row[menu-entry="17"] {
	display: none;
}

.menu-row:last-child {
	margin-bottom: 0;
}

.menu-row:hover {
	background-color: rgba(255, 255, 255, 40);
	border-color: rgba(255, 255, 255, 140);
}

.menu-row:active {
	background-color: rgba(255, 255, 255, 54);
	border-bottom-width: 1px;
}

.menu-label {
	display: block;
	position: absolute;
	left: 0;
	top: 50%;
	width: calc(100% * var(--root-scale));
	transform-origin: left center;
	transform: translateY(-50%) scale(calc(1 / var(--root-scale)));
	text-align: center;
	white-space: nowrap;
	font-weight: bold;
	color: token(text-primary);
	pointer-events: none;
}

#rows scrollbarvertical {
	width: 6px;
	margin: 0;
}

#rows scrollbarvertical slidertrack {
	background-color: rgba(255, 255, 255, 12);
}

#rows scrollbarvertical sliderbar {
	background-color: rgba(255, 255, 255, 90);
	border-radius: 3px;
}

#rows scrollbarvertical sliderbar:hover,
#rows scrollbarvertical sliderbar:active {
	background-color: rgba(255, 255, 255, 140);
}

#rows scrollbarvertical sliderarrowdec,
#rows scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}
