/* Modern theme for CSystemLogWindow. Geometry, the click-through rule and the text-width line
   backgrounds are identical to legacy's and traced to native there -- see legacy/system_log.rcss
   rather than repeating the derivation. Only the palette differs. */

#panel {
	position: absolute;
	left: 4dp;
	top: 84dp;
	width: 273dp;
	font-family: "token(font-chat)";
	font-size: 11dp;
	pointer-events: none;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
}

.syslog-line {
	display: block;
	white-space: nowrap;
	padding: 0 4dp;
	border-left: 2dp transparent;
	border-radius: token(radius-sm)px;
	position: relative;
}
/* The backdrop is a childless leaf carrying only the player's transparency setting; this theme
   picks its own surface rather than taking the original's black. */
.syslog-back {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: token(surface-recessed);
	border-radius: token(radius-sm)px;
}
.syslog-text { position: relative; }

/* Same two semantic states as legacy, restated in this theme's language: a left-edge accent plus
   a softened text colour, matching how chat_log.rcss distinguishes its own message types. */
.syslog-line--system {
	border-left-color: rgb(100, 150, 255);
	color: rgb(150, 185, 255);
}
.syslog-line--error {
	border-left-color: rgb(255, 60, 40);
	color: rgb(255, 120, 100);
}

/* Keep all six message rows available, including while no message is visible. */
#panel { min-height: 7.2em; }
#panel.workspace-placed { transform-origin: left top; }
.syslog-line { flex-shrink: 0; }

.syslog-line { min-height: 1.2em; }
.syslog-line.empty { border-left-color: transparent; }

/* Semantic colors match the MuOnlineS6 chat palette. */
.syslog-line--chat { color: #e1e1e1; }
.syslog-line--whisper { color: #ff32aa; }
.syslog-line--party { color: #00e1ff; }
.syslog-line--guild { color: #00e6aa; }
.syslog-line--union { color: #f5cd28; }
.syslog-line--gens { color: #96e164; }
.syslog-line--gm { color: #ffcd37; }
.syslog-line--system { color: #50a5ff; }
.syslog-line--error { color: #ff372d; }
.syslog-line--loot { color: #beb4ff; }
.syslog-line--experience { color: #e19bdc; }

.syslog-back { display: none; }
.syslog-line { border-left-width: 0; padding: 0 2dp; font-size: 9.5dp; line-height: 12dp; }
.syslog-text { font-effect: outline(1px #000000); }
.syslog-line--level-up { color: #ffd34e; }
