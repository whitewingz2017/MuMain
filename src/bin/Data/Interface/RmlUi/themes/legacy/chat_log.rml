<rml>
	<!-- Visible row count drives compact chat sizing in chat_text.rcss. -->
<head>
	<title>Chat Log</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="chat_log.rcss"/>
	<link type="text/rcss" href="../../chat_text.rcss"/>
</head>
<!-- Compact Dream typography; row count and theme geometry size the bottom-left history. -->
<body data-model="chat_log">
	<div id="panel" class="chat-history" data-class-framed="show_frame" data-style---visible-lines="visible_lines" data-style---chat-text-scale="text_scale">
		<div id="chat_backdrop" data-style-opacity="back_alpha"></div>
		<div id="resize_handle" data-class-hidden="!show_frame"
		     data-event-drag="chat_resize_drag"></div>

		<div id="lines" class="scroll-pane">
			<div data-for="line : lines"
                 data-style-opacity="line.opacity" data-style---entry-progress="line.entry_progress"
                 data-style---exit-progress="line.exit_progress"
			     data-attr-class="'chat-line chat-line--' + line.kind + (line.has_id ? ' chat-line--has-id' : '') + (it_index == pointed_index ? ' chat-line--pointed' : '')"
			     ><span class="chat-prefix" data-if="line.prefix != ''">{{line.prefix}} </span><span class="chat-name" data-if="line.sender != ''">{{line.sender}}: </span><span class="chat-body">{{line.text}}</span></div>
		</div>
	</div>
</body>
</rml>
