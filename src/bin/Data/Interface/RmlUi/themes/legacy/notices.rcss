/* Dream MU announcement stages: newest first, older messages shrink and move down. */
body
{
	width: 100%;
	height: 100%;
	display: block;
	pointer-events: none;
	focus: none;
}
.notice-root
{
	display: flex;
	flex-direction: column;
	align-items: center;
	position: absolute;
	top: 66vh;
	left: 0dp;
	right: 0dp;
	width: 100%;
	font-size: max(8px, 10dp);
	pointer-events: none;
}
.notice-line
{
	display: block;
	width: 900dp;
	max-width: 100vw;
	text-align: center;
	font-family: "token(font-notice)";
	font-weight: bold;
	font-size: 1dp;
	opacity: 0;
	color: #ffc850;
	font-effect: outline(1dp #00000090), glow(3dp #00000060), shadow(1dp 3dp #00000078);
	pointer-events: none;
	transform-origin: 50% 0%;
}
.notice-line.prep
{
	font-size: 1dp;
	opacity: 0;
	transform: translateY(-20dp);
	transition: none;
}
@keyframes notice-pulse
{
	from { color: #ffd468; }
	to { color: #cc7000; }
}
.notice-line.stage-in,
.notice-line.stage-in-alt
{
	font-size: 1em;
	opacity: 1;
	transform: translateY(0);
	transition: font-size 0.75s sine-in, opacity 1.25s sine-in, transform 0.75s sine-out;
	animation: 0.5s cubic-in-out infinite alternate notice-pulse;
}
.notice-line.tone-guild
{
	color: #64ffc8;
}
.notice-line.stage-in.tone-guild,
.notice-line.stage-in-alt.tone-guild
{
	font-size: 1em;
	opacity: 1;
	color: #64ffc8;
	transform: translateY(0);
	transition: font-size 0.75s sine-in, opacity 1.25s sine-in, transform 0.75s sine-out;
	animation: none;
}
.notice-line.stage-2
{
	font-size: 0.9em;
	opacity: 0.75;
	transform: translateY(0);
	transition: font-size 0.75s sine-out, opacity 1.25s sine-out;
}
.notice-line.stage-3
{
	font-size: 0.8em;
	opacity: 0.65;
	transform: translateY(0);
	transition: font-size 0.75s sine-out, opacity 1.25s sine-out;
}
.notice-line.stage-4
{
	font-size: 0.7em;
	opacity: 0.55;
	transform: translateY(0);
	transition: font-size 0.75s sine-out, opacity 1.25s sine-out;
}
.notice-line.stage-5
{
	font-size: 0.6em;
	opacity: 0.45;
	transform: translateY(0);
	transition: font-size 0.75s sine-out, opacity 1.25s sine-out;
}
.notice-line.stage-out,
.notice-line.stage-out-alt
{
	font-size: 1dp;
	opacity: 0;
	transform: translateY(0);
	transition: font-size 0.75s sine-out, opacity 1.35s sine-out;
}
.notice-line.snap
{
	transition: none;
	animation: none;
}
