/* Tall stacking panel beside the bag: two gear cards, a scrolling effect list and a fixed footer. */
#panel { position: absolute; left: 3vw; top: 6vh; width: 280dp; max-width: 47vw; height: 88vh; margin: 0; transform: none; font-family: "Liberation Sans"; color: #e8dfc7; font-size: 11dp; }
#panel .window-shell-content { position: absolute; left: 6%; right: 6%; top: 0; bottom: 0; padding: 0; pointer-events: auto; }
#panel .window-shell-header-title { font-size: 16dp; color: #d1c27c; }
#panel .btn { position: relative; box-sizing: border-box; height: 30dp; line-height: 28dp; padding: 0; font-size: 12dp; }
#panel .combination-close { position: absolute; top: 1.5%; right: 0; width: 25dp; height: 25dp; line-height: 23dp; z-index: 2; }
.combination-inputs { position: absolute; left: 8%; right: 8%; top: 11%; height: 26%; display: flex; flex-direction: row; justify-content: space-between; align-items: stretch; }
.combination-input { width: 32%; text-align: center; }
.combination-gear-label { display: block; box-sizing: border-box; height: 18dp; line-height: 16dp; font-size: 9dp; white-space: nowrap; border: 1dp #48483c; background-color: #151510e0; color: #c6bd93; }
.combination-slot { display: block; position: relative; width: 100%; height: calc(100% - 18dp); box-sizing: border-box; border: 2dp #55554a; background-color: #090d10a0; }
.combination-slot.selected { border-color: #c8c95c; box-shadow: 0 0 5dp #9fa34f; }
.combination-slot img { position: absolute; left: 5%; top: 5%; width: 90%; height: 90%; pointer-events: none; }
.combination-slot img.hidden { display: none; }
.combination-add { position: absolute; top: 50%; left: 0; width: 100%; height: 40dp; margin-top: -20dp; text-align: center; font-size: 38dp; line-height: 40dp; color: #d9c661; text-shadow: 0 2dp 4dp #b67522; pointer-events: none; }
.combination-arrow { align-self: center; width: 20%; font-size: 42dp; text-align: center; color: #d9cf78; text-shadow: 0 2dp 3dp #635526; pointer-events: none; }
.combination-rate { position: absolute; top: 39%; left: 0; width: 79%; height: 5%; text-align: center; font-size: 11dp; color: #51d62d; }
.combination-rate span { font-size: 17dp; }
.combination-effects-title { position: absolute; left: 1%; right: 1%; top: 48%; height: 5%; font-size: 12dp; }
.combination-effects-title span { color: #d3bf60; }
.combination-effects { position: absolute; left: 3%; right: 3%; top: 54%; bottom: 30%; overflow: hidden auto; pointer-events: auto; }
.combination-option { display: flex; flex-direction: row; align-items: center; position: relative; box-sizing: border-box; width: 100%; min-height: 24dp; padding: 4dp 6dp; margin-bottom: 5dp; border: 1dp #56594e; background-color: #050707da; font-size: 10dp; line-height: 14dp; color: #d2d2ca; }
.combination-option.potential { color: #54d836; }
.combination-option-text { display: block; flex: 1 1 0; min-width: 0; white-space: normal; }
.combination-option-note { display: block; width: 35%; margin-left: 4dp; text-align: right; font-size: 8dp; color: #56b1ca; }
.combination-footer { position: absolute; left: 0; right: 0; bottom: 3%; height: 16%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; }
.combination-cost-row { display: flex; flex-direction: row; align-items: center; width: 94%; height: 26dp; margin-bottom: 8dp; }
.combination-cost-row > span { width: 20%; text-align: center; font-size: 11dp; }
.combination-cost { box-sizing: border-box; width: 80%; height: 26dp; padding: 3dp; border: 1dp #56594e; background-color: #030505e0; font-size: 10dp; line-height: 18dp; text-align: center; color: #db5d43; }
.combination-cost.affordable { color: #54d836; }
#panel .combination-execute { width: 42%; }
.combination-status { position: absolute; left: 3%; right: 3%; top: 70%; height: 7%; font-size: 9dp; line-height: 12dp; white-space: normal; color: #b9b5a6; }

.core-bonus { color: #eac66e; }
#panel .combination-cores { position: absolute; right: 0; top: 38%; width: 35dp; height: 35dp; line-height: 33dp; font-size: 10dp; }
.combination-cores img { width: 22dp; height: 28dp; vertical-align: middle; }
.combination-core-name { position: absolute; right: 0; top: 45%; height: 3%; font-size: 9dp; color: #d1c27c; text-align: right; }
.combination-failure-rule { position: absolute; left: 3%; right: 3%; top: 77%; height: 6%; font-size: 8dp; line-height: 10dp; color: #d4ab76; }
.core-overlay { position: absolute; left: -7%; right: -7%; top: 0; bottom: 0; background-color: #00000099; z-index: 5; }
.core-picker { position: absolute; left: 5%; right: 5%; top: 26%; height: 250dp; box-sizing: border-box; padding: 12dp; border: 1dp #9b875a; background-color: #080b0ff5; text-align: center; }
.core-picker-title { display: block; font-size: 15dp; color: #d1c27c; margin-bottom: 12dp; }
.core-picker-rate { display: block; font-size: 11dp; color: #51d62d; height: 28dp; }
.core-picker-rate span { font-size: 17dp; }
.core-picker-controls { display: flex; flex-direction: row; align-items: center; height: 34dp; margin-bottom: 10dp; }
#panel .core-picker-controls button { width: 30dp; height: 30dp; font-size: 22dp; }
/* Full-height hit area around a centered rail; the native range control owns thumb movement. */
.core-slider { position: relative; flex: 1 1 0; min-width: 0; height: 30dp; margin: 0 8dp; }
.core-slider-rail { position: absolute; left: 0; right: 0; top: 50%; height: 6dp; margin-top: -3dp; box-sizing: border-box; border: 1dp transparent; border-radius: 3dp; pointer-events: none; }
#core_slider { display: block; width: 100%; height: 30dp; }
#core_slider slidertrack { height: 30dp; pointer-events: auto; }
#core_slider sliderbar { width: 16dp; height: 22dp; margin-top: 4dp; box-sizing: border-box; }
#core_slider sliderarrowdec, #core_slider sliderarrowinc { width: 0; height: 0; }
#core_slider:disabled { opacity: 0.5; }
.core-picker-count { display: flex; flex-direction: row; align-items: center; justify-content: center; height: 55dp; margin-bottom: 10dp; }
.core-picker-count img { width: 34dp; height: 45dp; margin-right: 18dp; }
.core-picker-count div { text-align: left; font-size: 12dp; line-height: 22dp; }
#panel #core_confirm { display: block; width: 90dp; margin: 0 auto; }
.core-picker-max { display: block; margin-top: 12dp; font-size: 11dp; }

#panel .core-cancel { position: absolute; top: 4dp; right: 4dp; width: 22dp; height: 22dp; line-height: 20dp; font-size: 10dp; }
