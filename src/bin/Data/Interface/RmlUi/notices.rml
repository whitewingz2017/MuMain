<rml>
<head>
    <title>Announcements</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="notices.rcss"/>
</head>
<body data-model="notices">
    <!-- Viewport-centred stack at 66% height. Stable rows preserve entry, shrink and exit
         transitions while the history shifts; RCSS owns all dimensions and effects. -->
    <div id="notice_root" class="notice-root">
        <div data-for="line : lines" data-attr-class="'notice-line ' + line.stage + ' ' + line.kind">{{line.text}}</div>
        <div data-attr-class="'notice-line ' + outgoing_stage + ' ' + outgoing_kind">{{outgoing_text}}</div>
    </div>
</body>
</rml>
