<rml>
<head>
    <title>Game Loading</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="title_scene.rcss"/>
</head>
<body>
    <div id="loading_background"><div id="background_left"></div><div id="background_right"></div></div>
    <div id="loading_bottom">
        <div id="loading_track">
            <progress id="gauge_fill" direction="right" value="0" max="1"/>
            <div id="gauge_head"></div>
        </div>
    </div>
    <div id="loading_percent"></div>
</body>
</rml>
