<rml><head><title>Excellent Option Combination</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="../../excellent_combination_common.rcss"/><link type="text/rcss" href="excellent_combination.rcss"/><link type="text/template" href="window_shell.rml"/></head>
<body template="window_shell" data-model="excellent_combination">
<button id="combination_close" class="btn combination-close" data-event-click="combination_close">X</button>
<div class="combination-input primary"><span>Primary Item</span><div id="combination_slot_0" class="combination-slot" data-event-click="combination_inspect(0)"><img id="combination_item_0"/></div></div>
<div class="combination-input secondary"><span>Secondary Item</span><div id="combination_slot_1" class="combination-slot" data-event-click="combination_inspect(1)"><img id="combination_item_1"/></div></div>
<div class="combination-arrow">&gt;</div><div class="combination-result"><span>Result Item</span><div id="combination_slot_2" class="combination-slot" data-event-click="combination_inspect(2)"><img id="combination_item_2"/></div><span class="combination-preview-note">Excellent options may change.</span></div>
<div class="combination-footer"><span>{{cost}}</span><button class="btn" data-class-disabled="!can_combine" data-event-click="combination_execute">Combine</button></div><div class="combination-status">{{status}}</div>
</body></rml>
