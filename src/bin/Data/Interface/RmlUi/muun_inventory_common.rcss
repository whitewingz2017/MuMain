#panel #muun-book, #panel #muun-exchange { top: 12%; height: 4.5%; width: 36%; color: #e7d292; font-size: 1.6vh; background-color: #00000090; }
#panel #muun-book { left: 12%; } #panel #muun-exchange { left: 52%; }
