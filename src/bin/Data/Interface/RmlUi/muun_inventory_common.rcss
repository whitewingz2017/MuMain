/* Main5.2 PetInventoryFrame: original 327 x 639 geometry and atlas pixels. */
#panel { position: absolute; top: 4vh; right: 27vw; width: 45.033vh; height: 88vh; margin: 0; font-family: "Liberation Sans"; color: #e7d292; pointer-events: auto; }
#muun-chrome { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
#muun-title { position: absolute; left: 24%; top: 6.7%; width: 50%; height: 3%; font-size: 2vh; line-height: 2.3vh; text-align: center; }
#muun-main-label, #muun-sub-label { position: absolute; top: 14.8%; width: 28%; height: 3%; text-align: center; font-size: 1.6vh; line-height: 2vh; }
#muun-main-label { left: 20%; } #muun-sub-label { left: 54%; }
#panel button { position: absolute; padding: 0; margin: 0; border: 0; background-color: transparent; decorator: none; min-width: 0; min-height: 0; }
#panel button:hover, #panel button:active, #panel button:focus { background-color: transparent; decorator: none; }
#panel .muun-close { left: 80%; top: 4%; width: 15%; height: 9%; }
.muun-cell { position: absolute; width: 16.52%; height: 8.76%; }
.muun-image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
#panel .muun-hit { left: 0; top: 0; width: 100%; height: 100%; drag: drag-drop; }
#panel .muun-hit:hover { background-color: #d4af3720; }
#panel .muun-pager { top: 91%; width: 10%; height: 6%; }
#panel #muun-previous { left: 35%; } #panel #muun-next { left: 59%; }
#muun-page { position: absolute; left: 43%; top: 92%; width: 19%; height: 4%; text-align: center; font-size: 1.7vh; line-height: 2.6vh; }
#muun-status { position: absolute; left: 3%; top: 100%; width: 94%; height: 5vh; font-size: 1.5vh; line-height: 1.7vh; white-space: normal; background-color: #000000b0; }
#panel #muun-refresh { left: 5%; top: 92%; width: 24%; height: 4%; color: #e7d292; font-size: 1.5vh; }
