<rml>
<!-- Message age controls its normalized slide offset. -->
<head>
	<title>System Log</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="system_log.rcss"/>
	<link type="text/rcss" href="../../chat_text.rcss"/>
</head>
<body data-model="system_log">
	<!-- Passive top-left overlay: at most 6 lines, no chrome, no scrolling and no interaction at
	     all (native's UpdateMouseEvent/UpdateKeyEvent are stubs). Nothing here opts into
	     pointer-events, so world clicks pass straight through -- see system_log.rcss. -->
	<div id="panel">
		<!-- Per-line background rather than one panel fill: native called RenderText() with the
		     alpha set per message and no box width, so each line gets its own quad sized to its
		     own text. The backdrop is its own childless leaf so the theme
		     owns its colour and the user's transparency setting stays bound; the whole line fades with age. -->
		<div data-for="line : lines"
                 data-style-opacity="line.opacity" data-style---entry-progress="line.entry_progress"
                 data-style---exit-progress="line.exit_progress"
		     data-attr-class="'syslog-line syslog-line--' + line.kind" data-class-empty="line.text == ''"

		     ><div data-if="line.text != '' &amp;&amp; line.opacity > 0" class="syslog-back" data-style-opacity="back_alpha * line.opacity"></div><span class="syslog-text"><span class="chat-prefix" data-if="line.prefix != ''">{{line.prefix}} </span><span class="chat-name" data-if="line.sender != ''">{{line.sender}}: </span><span class="chat-body">{{line.text}}</span></span></div>
	</div>
</body>
</rml>
