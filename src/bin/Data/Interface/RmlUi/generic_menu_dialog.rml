<rml>
<head>
	<title>Generic Menu Dialog</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="skill_icons.rcss"/>
	<link type="text/rcss" href="master_skill_icons.rcss"/>
	<link type="text/rcss" href="generic_menu_dialog.rcss"/>
<!-- Links resolve from the theme folder (themes/<theme>/); the shared sheet is two up. -->
	<link type="text/rcss" href="../../timer_bank_common.rcss"/>
	<link type="text/template" href="window_shell.rml"/>
</head>
<!-- Sibling primitive to generic_confirm_dialog.rml -- see GenericMenuDialog.h's own class
     comment for why this is a separate primitive (arbitrary N-button list vs two fixed named
     buttons) and why it's a single document, unlike generic_confirm_dialog's fg/bg split (no
     item3D here, so no compositing-order problem to solve).

     This is legacy's own markup in practice -- modern has its own complete fork
     (themes/modern/generic_menu_dialog.rml). Keep ids/data-model/event names in sync,
     GenericMenuDialog.cpp binds both by name.

     Frame/border/header chrome now lives entirely in window_shell.rml (see its own comment) --
     this document supplies only its own content, spliced into that template's #content slot. -->
<body template="window_shell" data-model="generic_menu_dialog" data-class-timer-bank="kind == 'event-timers' || kind == 'jewel-bank'" data-class-event-timers="kind == 'event-timers'" data-class-jewel-bank="kind == 'jewel-bank'" data-class-system-menu="is_system_menu"
      data-class-highlight-title="highlight_title"
      data-class-native-frame="kind != ''" data-attr-data-kind="kind" data-attr-data-id="menu_id"
      data-style---canvas-top="canvas_top + 'dp'">
    <img class="timer-bank-frame" data-if="kind == 'event-timers' || kind == 'jewel-bank'" src="../../../Muun/list_frame.tga"/>
    <div class="timer-bank-title" data-if="kind == 'event-timers' || kind == 'jewel-bank'">{{title}}</div>
    <button class="timer-bank-close" data-if="kind == 'event-timers' || kind == 'jewel-bank'" data-event-click="gmd_cancel">X</button>

	<!-- The menu's own lines. A menu that names the native box it replaces (GenericMenuConfig::kind,
	     data-kind) is laid out like that box in generic_menu_dialog.rcss: its lines where the box's
	     RenderTexts() drew them and its buttons at their offsets. The kinds whose box drew each
	     centred line as one line in its text box shrink it to that box when wider (.native-fit,
	     RmlNativeTextFit.h). -->
	<div class="gmd-lines">
		<div class="gmd-line" data-for="line : lines" data-class-bold="line.bold"
		     data-style-color="line.color == '' ? '#ffffff' : line.color"><span
		     data-class-native-fit="kind == 'npc-menu' || kind == 'trainer-recover' || kind == 'elpis' || kind == 'reset-points' || kind == 'delgardo'">{{line.text}}</span></div>
	</div>
	<div class="gmd-divider"></div>
	<!-- No explicit column count -- .gmd-button-row's own flex-wrap lets the button count/width
	     and the row's available space determine layout, same technique the numeric-keypad grid in
	     generic_confirm_dialog.rcss already proves. Every native consumer's own fixed 128dp button
	     width only ever fits one per row here, so this naturally reproduces their single-column
	     stack with no config knob needed. -->
	<div class="gmd-button-row">
		<!-- it_index (RmlUi's own data-for loop variable) passed straight into the click handler
		     -- proven pattern, see char_make.rml's job-select buttons for the original precedent.
		     gmd-button-cell wraps each button together with its own optional description lines
		     (button.lines, a nested data-for -- RmlUi re-parses each outer iteration's own inner
		     RML, so the inner loop and the outer button/it_index aliases both resolve normally) so
		     text that describes one specific button (e.g. CChaosMixMenuMsgBox's per-recipe blurb)
		     renders directly above that button instead of bunched into the shared summary above. -->
		<div class="gmd-button-cell" data-for="button : buttons" data-class-has-step-actions="button.has_step_actions" data-class-has-actions="button.secondary_label != ''" data-class-compact="button.compact" data-class-has-lines="button.has_lines" data-class-cols-2="button.cols2"
		     data-class-lines-below="button.lines_below">
			<div class="gmd-line" data-for="line : button.lines" data-class-bold="line.bold"
			     data-style-color="line.color == '' ? '#ffffff' : line.color"><span
			     data-class-native-fit="kind == 'chaos-mix'">{{line.text}}</span></div>
			<div class="btn gmd-btn" data-class-compact="button.compact" data-class-cols-2="button.cols2" data-class-disabled="!button.enabled"
			     data-class-narrow="button.narrow"
			     data-event-click="gmd_button_click(it_index)" data-attr-data-hint="button.tooltip">
				<!-- Label text lives in its own element rather than raw text directly in
				     .gmd-btn -- see generic_menu_dialog.rcss's own .gmd-btn.cols-2 comment
				     for why (a decorator change, not a markup requirement of its own). -->
				<img class="gmd-button-icon" data-if="button.has_icon" data-attr-id="'menu_icon_' + it_index"/>
				<div class="gmd-skill-icon" data-if="button.icon_decorator != ''" data-style-decorator="button.icon_decorator"></div><div class="gmd-btn-label">{{button.label}}</div><div class="gmd-btn-detail" data-if="button.detail != ''">{{button.detail}}</div>
            </div>
            <div class="gmd-row-actions" data-if="button.secondary_label != ''">
                <button class="gmd-step-action" data-if="button.has_step_actions" data-event-click="gmd_button_action(it_index, 3)" data-attr-data-hint="button.tooltip">+</button>
                <button class="gmd-step-action" data-if="button.has_step_actions" data-event-click="gmd_button_action(it_index, 4)" data-attr-data-hint="button.tooltip">-</button>
                <button data-event-click="gmd_button_action(it_index, 1)">{{button.secondary_label}}</button>
                <button data-event-click="gmd_button_action(it_index, 2)">{{button.tertiary_label}}</button>
            </div>
        </div>
    </div>
</body>
</rml>
