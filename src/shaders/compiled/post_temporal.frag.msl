#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FSInput
{
    float4 pos;
    float2 uv;
};

struct ColorBox
{
    float3 minimum;
    float3 maximum;
};

struct TemporalUniforms
{
    float4x4 currentToPrevious;
    float2 inverseTargetSize;
    float2 jitter;
    float historyWeight;
    float objectMotionWritten;
    float padding0;
    float padding1;
};

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float2 input_uv [[user(locn0)]];
};

static inline __attribute__((always_inline))
float3 RgbToYCoCg(thread const float3& rgb)
{
    return float3(((0.25 * rgb.x) + (0.5 * rgb.y)) + (0.25 * rgb.z), (0.5 * rgb.x) - (0.5 * rgb.z), (((-0.25) * rgb.x) + (0.5 * rgb.y)) - (0.25 * rgb.z));
}

static inline __attribute__((always_inline))
ColorBox NeighbourhoodBox(thread const float2& uv, thread const float3& centre, constant TemporalUniforms& _61, texture2d<float> scene, sampler sceneSampler)
{
    float3 minimum = centre;
    float3 maximum = centre;
    float3 sum = centre;
    float3 sumOfSquares = centre * centre;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            if ((x == 0) && (y == 0))
            {
                continue;
            }
            float2 neighbourUv = uv + (float2(float(x), float(y)) * _61.inverseTargetSize);
            float3 param = scene.sample(sceneSampler, neighbourUv).xyz;
            float3 neighbour = RgbToYCoCg(param);
            minimum = fast::min(minimum, neighbour);
            maximum = fast::max(maximum, neighbour);
            sum += neighbour;
            sumOfSquares += (neighbour * neighbour);
        }
    }
    float3 mean = sum / float3(9.0);
    float3 deviation = sqrt(fast::max((sumOfSquares / float3(9.0)) - (mean * mean), float3(0.0)));
    ColorBox box;
    box.minimum = fast::max(minimum, mean - (deviation * 1.0));
    box.maximum = fast::min(maximum, mean + (deviation * 1.0));
    return box;
}

static inline __attribute__((always_inline))
float2 UvToClip(thread const float2& uv)
{
    return float2((uv.x * 2.0) - 1.0, 1.0 - (uv.y * 2.0));
}

static inline __attribute__((always_inline))
float2 ClipToUv(thread const float2& clip)
{
    return float2((clip.x * 0.5) + 0.5, 0.5 - (clip.y * 0.5));
}

static inline __attribute__((always_inline))
float2 HistoryUv(thread const float2& uv, constant TemporalUniforms& _61, texture2d<float> sceneDepth, sampler depthSampler, texture2d<float> objectMotion, sampler objectMotionSampler)
{
    float closestDepth = 1.0;
    float2 closestUv = uv;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            float2 neighbourUv = uv + (float2(float(x), float(y)) * _61.inverseTargetSize);
            float depth = sceneDepth.sample(depthSampler, neighbourUv).x;
            if (depth < closestDepth)
            {
                closestDepth = depth;
                closestUv = neighbourUv;
            }
        }
    }
    if (_61.objectMotionWritten > 0.0)
    {
        float4 motion = objectMotion.sample(objectMotionSampler, closestUv);
        if (motion.w > 0.0)
        {
            if (any(abs(motion.xy) > float2(0.25)))
            {
                return float2(-1.0);
            }
            float2 param = uv;
            float2 param_1 = UvToClip(param) + motion.xy;
            return ClipToUv(param_1);
        }
    }
    float2 param_2 = closestUv;
    float2 clip = UvToClip(param_2) - _61.jitter;
    float4 previousClip = _61.currentToPrevious * float4(clip, closestDepth, 1.0);
    if (previousClip.w <= 9.9999997473787516355514526367188e-06)
    {
        return float2(-1.0);
    }
    float2 movement = (previousClip.xy / float2(previousClip.w)) - clip;
    float2 param_3 = uv;
    float2 param_4 = UvToClip(param_3) + movement;
    return ClipToUv(param_4);
}

static inline __attribute__((always_inline))
float3 SampleHistory(thread const float2& uv, constant TemporalUniforms& _61, texture2d<float> history, sampler historySampler)
{
    float2 position = uv / _61.inverseTargetSize;
    float2 centre = floor(position - float2(0.5)) + float2(0.5);
    float2 f = position - centre;
    float2 weight0 = f * (float2(-0.5) + (f * (float2(1.0) - (f * 0.5))));
    float2 weight1 = float2(1.0) + ((f * f) * (float2(-2.5) + (f * 1.5)));
    float2 weight2 = f * (float2(0.5) + (f * (float2(2.0) - (f * 1.5))));
    float2 weight3 = (f * f) * (float2(-0.5) + (f * 0.5));
    float2 weight12 = weight1 + weight2;
    float2 uv0 = (centre - float2(1.0)) * _61.inverseTargetSize;
    float2 uv12 = (centre + (weight2 / weight12)) * _61.inverseTargetSize;
    float2 uv3 = (centre + float2(2.0)) * _61.inverseTargetSize;
    float3 color = history.sample(historySampler, float2(uv12.x, uv0.y), level(0.0)).xyz * (weight12.x * weight0.y);
    color += (history.sample(historySampler, float2(uv0.x, uv12.y), level(0.0)).xyz * (weight0.x * weight12.y));
    color += (history.sample(historySampler, uv12, level(0.0)).xyz * (weight12.x * weight12.y));
    color += (history.sample(historySampler, float2(uv3.x, uv12.y), level(0.0)).xyz * (weight3.x * weight12.y));
    color += (history.sample(historySampler, float2(uv12.x, uv3.y), level(0.0)).xyz * (weight12.x * weight3.y));
    float weightSum = ((((weight12.x * weight0.y) + (weight0.x * weight12.y)) + (weight12.x * weight12.y)) + (weight3.x * weight12.y)) + (weight12.x * weight3.y);
    return fast::max(color / float3(weightSum), float3(0.0));
}

static inline __attribute__((always_inline))
float3 ClipToBox(thread const float3& color, thread const ColorBox& box)
{
    float3 centre = (box.maximum + box.minimum) * 0.5;
    float3 extent = ((box.maximum - box.minimum) * 0.5) + float3(9.9999997473787516355514526367188e-05);
    float3 offset = color - centre;
    float3 units = abs(offset / extent);
    float largest = fast::max(units.x, fast::max(units.y, units.z));
    return select(color, centre + (offset / float3(largest)), bool3(largest > 1.0));
}

static inline __attribute__((always_inline))
float3 YCoCgToRgb(thread const float3& ycocg)
{
    return float3((ycocg.x + ycocg.y) - ycocg.z, ycocg.x + ycocg.z, (ycocg.x - ycocg.y) - ycocg.z);
}

static inline __attribute__((always_inline))
float4 _main(thread const FSInput& _input, constant TemporalUniforms& _61, texture2d<float> scene, sampler sceneSampler, texture2d<float> sceneDepth, sampler depthSampler, texture2d<float> objectMotion, sampler objectMotionSampler, texture2d<float> history, sampler historySampler)
{
    float2 uv = _input.pos.xy * _61.inverseTargetSize;
    float4 current = scene.sample(sceneSampler, uv);
    if (_61.historyWeight <= 0.0)
    {
        return current;
    }
    float3 param = current.xyz;
    float2 param_1 = uv;
    float3 param_2 = RgbToYCoCg(param);
    ColorBox box = NeighbourhoodBox(param_1, param_2, _61, scene, sceneSampler);
    float2 param_3 = uv;
    float2 historyUv = HistoryUv(param_3, _61, sceneDepth, depthSampler, objectMotion, objectMotionSampler);
    if (any(historyUv < float2(0.0)) || any(historyUv > float2(1.0)))
    {
        return current;
    }
    float2 param_4 = historyUv;
    float3 param_5 = SampleHistory(param_4, _61, history, historySampler);
    float3 param_6 = RgbToYCoCg(param_5);
    ColorBox param_7 = box;
    float3 param_8 = ClipToBox(param_6, param_7);
    float3 previous = YCoCgToRgb(param_8);
    float motionPixels = length((historyUv - uv) / _61.inverseTargetSize);
    float blendWeight = _61.historyWeight / (1.0 + motionPixels);
    return float4(mix(current.xyz, previous, float3(blendWeight)), current.w);
}

fragment main0_out main0(main0_in in [[stage_in]], constant TemporalUniforms& _61 [[buffer(0)]], texture2d<float> scene [[texture(0)]], texture2d<float> sceneDepth [[texture(1)]], texture2d<float> objectMotion [[texture(2)]], texture2d<float> history [[texture(3)]], sampler sceneSampler [[sampler(0)]], sampler depthSampler [[sampler(1)]], sampler objectMotionSampler [[sampler(2)]], sampler historySampler [[sampler(3)]], float4 gl_FragCoord [[position]])
{
    main0_out out = {};
    FSInput _input;
    _input.pos = gl_FragCoord;
    _input.uv = in.input_uv;
    FSInput param = _input;
    out._entryPointOutput = _main(param, _61, scene, sceneSampler, sceneDepth, depthSampler, objectMotion, objectMotionSampler, history, historySampler);
    return out;
}

